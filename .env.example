# DóndeTa web client configuration.
# Keep VITE_USE_API=false to preserve the standalone Figma/fixture experience.
VITE_USE_API=false
VITE_API_BASE_URL=http://localhost:3001/api

# Google AdSense. Leave all of these unset until the site's AdSense review is
# approved -- AdBanner (src/components/AdBanner.tsx) shows the "Anúnciate
# aquí" placeholder whenever the client id or a given slot id is missing, so
# nothing breaks in the meantime. Fill in after approval:
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_SLOT_LEADERBOARD=
VITE_ADSENSE_SLOT_MEDIUM_RECTANGLE=
VITE_ADSENSE_SLOT_MOBILE_BANNER=

# Admin portal (/admin). Comma-separated emails of DóndeTa accounts allowed in.
ADMIN_EMAILS=
# GA4 traffic in the admin portal: numeric property id (Admin -> Property
# details, not the G-XXXX id) and the service account key JSON (raw or base64).
GA_PROPERTY_ID=
GA_SERVICE_ACCOUNT_JSON=
# /admin "Descargas e ingresos" (apps/api/src/admin/store-stats.ts). JSON secrets raw or base64.
# Google Play installs: service account with account-level "view app info and download bulk reports".
PLAY_SERVICE_ACCOUNT_JSON=
PLAY_REPORTS_BUCKET=
PLAY_PACKAGE_NAME=com.jfmcss.dondeta
# App Store downloads: App Store Connect API key (.p8 contents, raw or base64) + vendor number.
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_PRIVATE_KEY=
ASC_VENDOR_NUMBER=
ASC_APP_ID=6835941043
# AdMob + AdSense earnings: owner OAuth consent (apps/api/scripts/google-ads-oauth.mjs).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
ADS_PUBLISHER_ID=pub-3955748382514121
