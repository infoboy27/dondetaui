# DóndeTa web client configuration.
# Keep VITE_USE_API=false to preserve the standalone Figma/fixture experience.
VITE_USE_API=false
VITE_API_BASE_URL=http://localhost:3001/api

# Google AdSense. Leave all of these unset until the site's AdSense review is
# approved -- AdBanner (src/components/AdBanner.tsx) shows the "Anúnciate
# aquí" placeholder whenever the client id or a given slot id is missing, so
# nothing breaks in the meantime. Fill in after approval:
VITE_ADSENSE_CLIENT_ID=
VITE_ADSENSE_SLOT_LEADERBOARD=
VITE_ADSENSE_SLOT_MEDIUM_RECTANGLE=
VITE_ADSENSE_SLOT_MOBILE_BANNER=
