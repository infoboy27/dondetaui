FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable
COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile
COPY . .
ARG VITE_USE_API=true
ARG VITE_API_BASE_URL=/api
ARG VITE_ADSENSE_CLIENT_ID=
ARG VITE_ADSENSE_SLOT_LEADERBOARD=
ARG VITE_ADSENSE_SLOT_MEDIUM_RECTANGLE=
ARG VITE_ADSENSE_SLOT_MOBILE_BANNER=
# Per-country deployment config. VITE_CURRENCY_SYMBOL blank here means
# src/domain/currency.ts falls back to its own 'RD$' default at runtime --
# dondeta.com.do keeps working unchanged without setting this.
ARG VITE_CURRENCY_SYMBOL=
ARG VITE_CURRENCY_LOCALE=es-DO
ARG VITE_COUNTRY_FLAG=
ENV VITE_USE_API=$VITE_USE_API
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_ADSENSE_CLIENT_ID=$VITE_ADSENSE_CLIENT_ID
ENV VITE_ADSENSE_SLOT_LEADERBOARD=$VITE_ADSENSE_SLOT_LEADERBOARD
ENV VITE_ADSENSE_SLOT_MEDIUM_RECTANGLE=$VITE_ADSENSE_SLOT_MEDIUM_RECTANGLE
ENV VITE_ADSENSE_SLOT_MOBILE_BANNER=$VITE_ADSENSE_SLOT_MOBILE_BANNER
ENV VITE_CURRENCY_SYMBOL=$VITE_CURRENCY_SYMBOL
ENV VITE_CURRENCY_LOCALE=$VITE_CURRENCY_LOCALE
ENV VITE_COUNTRY_FLAG=$VITE_COUNTRY_FLAG
RUN pnpm build

FROM nginx:1.29-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --retries=3 CMD wget -qO- http://127.0.0.1/healthz >/dev/null || exit 1
