# Copy to .env on the server and change secrets.
POSTGRES_DB=dondeta
POSTGRES_USER=dondeta
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=3001
WEB_PORT=8080
DATABASE_POOL_MAX=10
# Fake catalog/user rows for trying the app out. Leave false once real
# ingestion + real signups are the actual data source, or every fresh
# `docker compose up` reseeds fixture products/users into the real DB.
LOAD_DEV_SEED=false
# production enables the fail-closed CORS_ORIGINS check in main.ts (a blank
# CORS_ORIGINS with NODE_ENV=production refuses to boot instead of allowing
# any origin) and disables framework debug output.
NODE_ENV=production
# Required when NODE_ENV=production — comma-separated origins allowed to
# call the API, e.g. https://dondeta.jfmcss.com
CORS_ORIGINS=
JWT_SECRET=replace-with-a-long-random-secret

# Google Analytics 4 measurement id (e.g. G-XXXXXXX), once you've created a
# GA4 property. Only used by apps/web-seo's server-rendered product pages —
# the main SPA reads its own copy from .figma/make/site.json's
# analytics.googleAnalyticsId instead (a build-time config file, not this
# runtime env var).
GA_MEASUREMENT_ID=

# Optional Discord webhooks for ops visibility. Blank means alerts are
# silently skipped (see apps/api/src/common/discord-webhook.ts), same
# fail-safe pattern as the RESEND/TWILIO keys below -- a missing/invalid
# webhook never breaks the request it's reporting on.
# Fires on every successful registration.
DISCORD_WEBHOOK_REGISTRATIONS=
# Fires on: any 5xx server error, and repeated /api/auth/* rate-limit
# rejections (a brute-force/credential-stuffing signal). Does NOT cover
# full downtime (the app itself being unreachable) -- that needs an
# external check; see deploy/uptime-check.sh.
DISCORD_WEBHOOK_ALERTS=

# Optional Postgres backups. Start with:
# docker compose --profile backup up -d
# Writes gzipped pg_dump snapshots to the dondeta_backups volume on a timer
# and prunes anything older than BACKUP_RETENTION_DAYS. This protects against
# a bad migration or accidental DELETE, not against losing the whole host —
# periodically copy the volume off-box too.
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14

# Optional price-drop alerts worker. Start with:
# docker compose --profile alerts up -d
# Blank RESEND_API_KEY/TWILIO_* means notifications are logged, not sent.
ALERTS_INTERVAL_SECONDS=1800
RESEND_API_KEY=
RESEND_FROM_EMAIL=alertas@dondeta.jfmcss.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_WHATSAPP_FROM=

# Optional ingestion worker. Start with:
# docker compose --profile ingestion up -d
INGESTION_INTERVAL_SECONDS=21600
PLAZA_LAMA_MAX_CATEGORY_PAGES=30
PLAZA_LAMA_MAX_PRODUCTS=500
# Plaza Lama's robots.txt requests Crawl-delay: 3600 (1 request/hour) for
# generic user-agents. 8s is a deliberate middle ground, not full compliance —
# revisit if this ever needs to be defensible as a good citizen at scale.
PLAZA_LAMA_DISCOVERY_DELAY_MS=8000
PLAZA_LAMA_PRODUCT_DELAY_MS=8000
JUMBO_MAX_PAGES=30
JUMBO_MAX_PRODUCTS=500
SIRENA_MAX_PAGES=30
SIRENA_MAX_PRODUCTS=500
CORRIPIO_MAX_PAGES=30
CORRIPIO_MAX_PRODUCTS=500
PRICESMART_MAX_PAGES=20
PRICESMART_MAX_PRODUCTS=300
