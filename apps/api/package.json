{
  "name": "@dondeta/api",
  "version": "0.1.0",
  "private": true,
  "description": "DóndeTa backend API",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "start:dev": "tsx watch src/main.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm typecheck && pnpm build",
    "test:discovery": "tsx src/ingestion/plaza-lama.discovery.smoke.ts && tsx src/ingestion/retailer.discovery.smoke.ts && tsx src/ingestion/pricesmart.discovery.smoke.ts",
    "ingest:plaza-lama": "tsx src/ingestion/plaza-lama.cli.ts",
    "ingest:jumbo": "tsx src/ingestion/retailer.cli.ts jumbo",
    "ingest:sirena": "tsx src/ingestion/retailer.cli.ts sirena",
    "ingest:corripio": "tsx src/ingestion/retailer.cli.ts corripio",
    "ingest:pricesmart": "tsx src/ingestion/pricesmart.cli.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "pg": "^8.16.3",
    "playwright": "^1.62.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
