PORT=3001
DATABASE_URL=postgresql://dondeta:dondeta@localhost:5432/dondeta
DATABASE_POOL_MAX=10
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-value

# Plaza Lama ingestion.
# If PLAZA_LAMA_URLS is set, only those product URLs are ingested.
# If it is empty, the crawler discovers product URLs automatically from the configured category/home seeds.
PLAZA_LAMA_URLS=
PLAZA_LAMA_CATEGORY_URLS=https://plazalama.com.do/oldHome,https://plazalama.com.do/ca/electrodomesticos/4
PLAZA_LAMA_MAX_CATEGORY_PAGES=150
PLAZA_LAMA_MAX_PRODUCTS=5000
PLAZA_LAMA_DISCOVERY_DELAY_MS=500
PLAZA_LAMA_PRODUCT_DELAY_MS=350
