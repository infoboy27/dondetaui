# Use the LAN/VPS address reachable by the Android device.
# Example local LAN: http://192.168.1.50:3001/api
# Example dev server: https://dev.dondeta.example/api
EXPO_PUBLIC_API_URL=http://127.0.0.1:3001/api

# AdMob real banner ad unit id (Android). Leave unset to keep showing
# Google's test ads (AdBanner falls back to TestIds.BANNER automatically).
# Also swap the test androidAppId/iosAppId in app.json for real ones once an
# AdMob account/app exists -- see https://apps.admob.com.
EXPO_PUBLIC_ADMOB_BANNER_UNIT_ID_ANDROID=
