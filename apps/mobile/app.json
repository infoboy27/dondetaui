{
  "expo": {
    "name": "DóndeTa",
    "slug": "dondeta",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "dondeta",
    "icon": "./assets/icon.png",
    "android": {
      "package": "com.jfmcss.dondeta",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.jfmcss.dondeta",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Permite a DóndeTa usar la cámara para escanear códigos de barras.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permite a DóndeTa usar tu ubicación para mostrarte las tiendas más cercanas.",
          "locationAlwaysAndWhenInUsePermission": "Permite a DóndeTa usar tu ubicación para mostrarte las tiendas más cercanas.",
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#00B894"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "expo-router",
      "expo-status-bar",
      "expo-secure-store",
      "expo-font",
      [
        "react-native-google-mobile-ads",
        {
          "iosAppId": "ca-app-pub-3955748382514121~2657587887",
          "androidAppId": "ca-app-pub-3955748382514121~7018584852",
          "androidSdk": "classic",
          "delayAppMeasurementInit": true,
          "userTrackingUsageDescription": "DóndeTa usa este permiso para mostrarte anuncios más relevantes. Los anuncios ayudan a mantener la app gratis.",
          "skAdNetworkItems": [
            "cstr6suwn9.skadnetwork"
          ]
        }
      ],
      "./plugins/withSceneLifecycle"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1bd90f1b-b70a-4da9-a133-97790c19cd51"
      }
    },
    "owner": "jfmcss"
  }
}
