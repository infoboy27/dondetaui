# pnpm's supply-chain "minimum release age" default (currently 24h) rejects
# any lockfile entry published more recently than that, including fast-moving
# transitive deps like electron-to-chromium that publish almost daily. That
# protection matters for unpinned/dynamic resolution; it adds nothing for
# --frozen-lockfile installs (EAS Build's install step), which only ever
# install the exact versions already recorded in pnpm-lock.yaml.
minimum-release-age=0
