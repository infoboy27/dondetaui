# Server-side only (Next.js runs this fetch on the server, never the browser).
API_BASE_URL=http://localhost:3001/api

# The real public domain this deployment serves -- used for canonical URLs,
# sitemap.xml, robots.txt's Sitemap: directive, and metadataBase. Get this
# wrong and search engines get pointed at the wrong domain. Defaults to the
# dev domain (src/lib/site.ts) if unset.
SITE_URL=https://dondeta.jfmcss.com

# Optional — same measurement id as the main app's .figma/make/site.json
# analytics.googleAnalyticsId. Blank means no gtag.js on these pages.
GA_MEASUREMENT_ID=
